body{
    margin:0;
    padding:0;
    background:#f5f5f5;
    font-family:Arial;
}

.container{
    width:500px;
    margin:80px auto;
    background:white;
    padding:30px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

button{
    padding:12px 30px;
    background:green;
    color:white;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:darkgreen;
}

img{
    margin:20px;
    border-radius:10px;
}
